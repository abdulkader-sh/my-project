# انسخ هذا الملف إلى keystore.properties (بدون .example) في جذر المشروع، وعدّل القيم
# بمفتاح التوقيع الحقيقي الخاص بك. keystore.properties نفسه مُستثنى من Git عمداً (.gitignore)
# لأنه يحتوي أسراراً — لا تحذف هذا الاستثناء ولا ترفع الملف الحقيقي إلى أي مستودع.
storeFile=/absolute/path/to/your/release.jks
storePassword=CHANGE_ME
keyAlias=hisnaladhkar
keyPassword=CHANGE_ME
